ARSENAL_API_TOKEN=dev-token-change-me
# Simple UI panel password (default: 23513900) — same effect as API token
ARSENAL_PANEL_PASSWORD=23513900
PORT=3847
HOST=127.0.0.1
# H4CK_ROOT=/abs/path/to/h4ck

# ── Schrödinger P1 ───────────────────────────────────────────────────────────
# live = real dig/HTTP/TCP; mock = fixture path (CI / dig missing / demos)
# SCHRODINGER_SCAN_MODE=live

# DNS provider: auto (dig if present else mock) | dig | mock
# SCHRODINGER_DNS_MODE=auto

# Comma-separated domains, or * for any FQDN (still SSRF IP-blocked after resolve)
# SCHRODINGER_ALLOWLIST=*

# Feature flags — which vantages to run (default: all four)
# SCHRODINGER_VANTAGES=dns,ua,netweb,time

# Port profile for NetWeb: quick (80/443/8080/8443) | web (+dev ports)
# SCHRODINGER_PORT_PROFILE=quick

# Optional DoH second opinion (Google + Cloudflare) — never replaces dig
# SCHRODINGER_DOH=0

# DNS sampling / pool
# SCHRODINGER_DNS_SAMPLE=30
# SCHRODINGER_DNS_CONCURRENCY=6
# SCHRODINGER_DNS_TIMEOUT_MS=2500
# SCHRODINGER_DNS_RETRIES=1

# UA / HTTP paths (comma-separated)
# SCHRODINGER_UA_PATHS=/,/robots.txt,/wp-admin,/.well-known/security.txt

# Override rules file (default: shared/schrodinger-rules.json)
# SCHRODINGER_RULES_PATH=

# ── GCP path (optional) ─────────────────────────────────────────────────────
# On GCE / Cloud Shell: install dig (dnsutils), set SCHRODINGER_DNS_MODE=auto|dig.
# Mock mode works without dig for CI and air-gapped labs.
# SCHRODINGER_SCAN_MODE=live
# SCHRODINGER_DNS_MODE=auto
